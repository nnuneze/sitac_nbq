>         // ════════  DENSIDAD EFECTIVA DE NUBE BIFÁSICA (chorro de gas licuado)  ════
>         //  Un gas licuado que sale en fase LÍQUIDA a presión NO forma la nube del
>         //  vapor puro: forma un chorro FRÍO (a su Tb) cargado de AEROSOL. Las gotas
>         //  aportan MASA pero no VOLUMEN, así que la nube resulta DENSA aunque el
>         //  vapor puro sea más ligero que el aire.
>         //  Caso crítico: AMONÍACO (vd 0.59 → "ligero"), pero a 27 °C solo flashea
>         //  el ~21%: el 79% restante viaja como aerosol a −33 °C. ALOHA/CERES lo
>         //  modela como GAS PESADO en fuga líquida de tanque, y sin esta corrección
>         //  SITAC infravaloraba esas distancias un −36…−41%.
>         //  Estado de referencia: campo próximo, n≈1 kg de aire arrastrado por kg de
>         //  sustancia; el aerosol se evapora en parte a costa del calor sensible de
>         //  ese aire, y la mezcla queda a Tb.
>         //  ⚠️ CALIBRACIÓN: n=1.0 ajustado contra UN escenario CERES (NH₃ 31.25
>         //  kg/min, u=13 km/h, estab. C → 131/375/847 m; error resultante −1.0%).
>         //  Es un ajuste, no una validación amplia. Para el resto de gases licuados
>         //  (H₂S, HCl, propano, metilamina, óxido de etileno, butadieno) la fórmula
>         //  se aplica por coherencia física pero NO está contrastada con CERES.
>         const AIRE_MW = 28.84, AIRE_CP = 1.005, R_GAS = 8.314;
>         function vdEfectivaBifasica(code, tempC, vdTabla) {
>             const d = flashData[code];
>             if (!d) return vdTabla;                       // no es gas licuado: sin cambio
>             const MW = physChem[code] && physChem[code].MW;
>             if (!MW) return vdTabla;
>             const n  = 1.0;                               // arrastre de referencia (kg aire/kg sust.)
>             const Tb = d.Tb + 273.15, Ta = tempC + 273.15;
>             if (Ta <= Tb) return vdTabla;                 // ambiente bajo Tb: no flashea
>             const f = Math.max(0, Math.min(1, d.Cp * (tempC - d.Tb) / d.Hvap));
>             if (f <= 0) return vdTabla;
>             // aerosol evaporado con el calor que cede el aire arrastrado
>             const e = Math.min(1 - f, n * AIRE_CP * (Ta - Tb) / d.Hvap);
>             // volumen por kg de sustancia: solo el vapor y el aire ocupan volumen;
>             //  las gotas remanentes aportan masa sin volumen (de ahí la densidad).
>             const vol = (f + e) / (101.325 * MW      / (R_GAS * Tb))
>                       +  n      / (101.325 * AIRE_MW / (R_GAS * Tb));
>             if (!(vol > 0)) return vdTabla;
>             const vdBif = ((1 + n) / vol) / (101.325 * AIRE_MW / (R_GAS * Ta));
>             // NUNCA reduce: solo eleva si el chorro frío es más denso que el vapor
>             //  puro. Así la calibración de Cl₂/SO₂ (gases ya densos) queda intacta.
>             return Math.max(vdTabla, vdBif);
>         }
> 
